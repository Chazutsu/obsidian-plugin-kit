{
  "name": "obsidian-plugin-kit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": { "node": ">=24" },
  "description": "Reusable build, type, and deployment foundations for Obsidian plugins",
  "license": "MIT",
  "repository": "github:Chazutsu/obsidian-plugin-kit",
  "keywords": [
    "obsidian",
    "plugin-development",
    "rolldown"
  ],
  "type": "module",
  "exports": {
    "./deploy": {
      "types": "./src/deploy.d.ts",
      "default": "./src/deploy.mjs"
    },
    "./rolldown": {
      "types": "./src/rolldown.d.ts",
      "default": "./src/rolldown.mjs"
    },
    "./tsconfig": "./tsconfig.base.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.ja.md",
    "src",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "node --check src/rolldown.mjs && node --check src/deploy.mjs",
    "format": "oxfmt --write src/ tests/ scripts/",
    "format:check": "oxfmt --check src/ tests/ scripts/",
    "lint": "oxlint src/ tests/ scripts/",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "builtin-modules": ">=5",
    "rolldown": ">=1.0.0-rc.5"
  },
  "devDependencies": {
    "builtin-modules": "^5.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.48.0",
    "rolldown": "1.2.13",
    "typescript": "7.0.2"
  }
}

